# Netlify response headers.
# Filenames here are NOT version-suffixed, so nothing gets a one-year immutable
# cache except the fonts, which never change. Give an asset an immutable cache
# and a replaced photograph never reaches a returning visitor.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/*.css
  Cache-Control: public, max-age=3600

/assets/*.js
  Cache-Control: public, max-age=3600
